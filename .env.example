# Copy to .env and change only the values you need.
# The application also starts with these defaults when .env is absent.

DATABASE_URL=sqlite:///./certificates.db
STORAGE_DIR=./storage
MAX_RECIPIENTS_PER_JOB=500
MAX_REQUEST_BYTES=1048576
WORKER_POLL_INTERVAL_SECONDS=1
PROCESSING_LEASE_SECONDS=300
MAX_GENERATION_ATTEMPTS=3
LOG_LEVEL=INFO
MAX_NAME_LENGTH=200
MAX_EMAIL_LENGTH=254
MAX_COURSE_NAME_LENGTH=200
MAX_ISSUED_BY_LENGTH=200
CERTIFICATES_PAGE_SIZE_DEFAULT=100
CERTIFICATES_PAGE_SIZE_MAX=500
